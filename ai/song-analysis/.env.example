PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000

AI_UPLOAD_TICKET_SECRET=
BACKEND_ANALYSIS_RESULT_URL=http://localhost:8080/internal/api/songs/analysis-result
AI_INTERNAL_API_KEY=
BACKEND_CALLBACK_TIMEOUT_SECONDS=120
BACKEND_CALLBACK_MP3_BITRATE=192k
# 실패 업로드 보존은 로컬 디버깅에서만 1로 바꿉니다.
PRESERVE_FAILED_JOBS=0

# 선택 경로 변수는 사용할 때만 절대 경로로 지정합니다.
# LOCAL_RESULT_DIR=C:/absolute/path/to/results
# SYLLABLE_MODEL_DIR=C:/absolute/path/to/models
SYLLABLE_ALIGNMENT_DEVICE=cuda
SYLLABLE_WHISPER_MODEL=large-v3
SYLLABLE_ALIGNMENT_LANGUAGE=ko
SYLLABLE_ALIGNMENT_STRICT=1
AUDIO_SEPARATOR_CHUNK_DURATION_SECONDS=30
