# 백엔드 (Spring Boot)
NEXT_PUBLIC_API_URL=http://localhost:8080
API_URL=http://localhost:8080
# STOMP WebSocket은 프록시를 거치지 않고 백엔드 origin에 직접 연결한다
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# AI 서버 — scoring-feedback (채점·STT·피드백)
NEXT_PUBLIC_AI_BASE_URL=http://localhost:8000
# AI 서버 — song-analysis (곡 분석 업로드)
NEXT_PUBLIC_AI_SERVER_URL=http://localhost:8001

# 시연용 데모 채점. 'false'가 아니면 AI 채점을 건너뛰고 목 점수를 쓴다 (scoringConfig.ts 참고)
NEXT_PUBLIC_DEMO_MOCK_SCORING=false
