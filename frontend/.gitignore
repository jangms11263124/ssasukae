# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# 로컬 데모 실험 (커밋하지 않음)
/tempo-demo/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rnnoise 워클릿/WASM (copy:rnnoise-assets 스크립트가 자동 생성)
/public/noise-suppressor/

# SoundTouch AudioWorklet processor (copy:soundtouch-processor 스크립트가 자동 생성)
/public/soundtouch/

# 로컬 MR 테스트 샘플 (커밋하지 않음)
/public/dev/
